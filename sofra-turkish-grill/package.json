{
  "name": "sofra-turkish-grill",
  "private": true,
  "version": "1.0.0",
  "description": "Premium website redesign for Sofra Turkish Grill, Kent, Washington \u2014 prepared by AHM Digital LLC.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:client && npm run build:server && node scripts/prerender.mjs",
    "build:client": "vite build --outDir dist",
    "build:server": "vite build --ssr src/entry-server.tsx --outDir dist-ssr",
    "preview": "node scripts/serve.mjs",
    "typecheck": "tsc --noEmit",
    "check:links": "node scripts/check-links.mjs"
  },
  "dependencies": {
    "@fontsource-variable/cormorant-garamond": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-imagetools": "^12.0.1"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
